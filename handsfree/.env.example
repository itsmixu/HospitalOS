# Loopback-only synthetic fork. Do not use for real patient data.
HF_PORT=8790
# Enables explicitly labelled debug input injection, never for deployment.
ENABLE_SIMULATION=1
# Default: .local/handsfree.sqlite (ignored, synthetic records persist across restarts).
# Use :memory: for disposable automated tests only.
HF_DB_PATH=.local/handsfree.sqlite

# Real computer microphone with offline recognition; requires local speech setup.
ENABLE_LOCAL_SPEECH=1

# Optional local recognizer overrides (defaults discovered automatically).
# HF_WHISPER_BIN=/opt/homebrew/bin/whisper-cli
# HF_SPEECH_MODEL=.local/ggml-base.en.bin
